{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "key": "SoltrOS Reborn",
      "keyColor": "blue",
      "format": "{user-name}@{host-name}"
    },
    "separator",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": "Desktop",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block"
    }
  ]
}
